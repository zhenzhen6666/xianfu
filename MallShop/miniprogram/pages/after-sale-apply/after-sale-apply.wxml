<view class="apply-page"><view class="card"><text class="label">售后订单</text><text>{{orderNo}}</text></view><view class="card"><text class="label">售后原因</text><input value="{{reason}}" data-field="reason" bindinput="bind" maxlength="255" placeholder="例如：商品破损、少件、品质问题"/><text class="label">问题描述</text><textarea value="{{description}}" data-field="description" bindinput="bind" maxlength="1000" placeholder="请详细描述问题，便于商家快速处理"/></view><view class="card"><view class="head"><text class="label">图片凭证</text><text>{{images.length}}/6</text></view><view class="images"><view wx:for="{{images}}" wx:key="tempPath"><image src="{{item.tempPath}}" mode="aspectFill"/><text data-index="{{index}}" bindtap="remove">×</text></view><button wx:if="{{images.length<6}}" bindtap="chooseImages">＋<text>添加图片</text></button></view></view><button class="submit" loading="{{submitting}}" bindtap="submit">提交售后申请</button></view>
