.apply-page{min-height:100vh;padding:24rpx;background:#f5f7f5}.card{display:flex;flex-direction:column;gap:18rpx;margin-bottom:20rpx;padding:28rpx;background:#fff;border-radius:24rpx}.label{font-weight:800}.card input,.card textarea{box-sizing:border-box;width:100%;padding:22rpx;background:#f6f8f6;border-radius:16rpx}.card textarea{height:190rpx}.head{display:flex;justify-content:space-between}.images{display:flex;flex-wrap:wrap;gap:15rpx}.images view,.images button{position:relative;width:190rpx;height:190rpx;margin:0;padding:0}.images image{width:100%;height:100%;border-radius:16rpx}.images view text{position:absolute;top:-10rpx;right:-10rpx;width:44rpx;height:44rpx;color:#fff;background:#333;border-radius:50%;text-align:center;line-height:44rpx}.images button{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#849087;background:#f5f7f5;border-radius:16rpx;font-size:36rpx}.images button text{font-size:22rpx}.submit{margin-top:30rpx;background:#168a51;color:#fff;border-radius:44rpx}
