.detail-page{min-height:100vh;padding-bottom:150rpx;background:#f5f7f5}.hero{width:100%;height:620rpx;background:#edf2ed}.main,.section{margin-bottom:18rpx;padding:30rpx;background:#fff}.title-row{display:flex;justify-content:space-between}.title-row>view{display:flex;flex-direction:column;gap:10rpx}.title{font-size:40rpx;font-weight:800}.sub{color:#7d8981}.title-row button{margin:0;width:72rpx;height:72rpx;padding:0;color:#168a51;background:#ecf7ef;border-radius:50%;font-size:38rpx;line-height:72rpx}.price{margin-top:24rpx;color:#e8583c;font-size:52rpx;font-weight:800}.price>text:first-child{font-size:25rpx}.original{margin-left:18rpx;color:#a5ada8;font-size:25rpx;font-weight:400;text-decoration:line-through}.member{color:#ad7922}.service{display:flex;gap:28rpx;margin-top:22rpx;color:#168a51;font-size:23rpx}.section-title{display:block;margin-bottom:22rpx;font-weight:800}.sku-list{display:flex;flex-wrap:wrap;gap:16rpx}.sku{display:flex;min-width:180rpx;flex-direction:column;gap:6rpx;padding:20rpx;border:2rpx solid #e7ece8;border-radius:18rpx}.sku small{color:#849087;font-size:21rpx}.sku.active{border-color:#168a51;background:#eff9f2}.sku.disabled{opacity:.4}.quantity{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx}.quantity view{display:flex;align-items:center;gap:22rpx}.quantity button{width:60rpx;height:58rpx;margin:0;padding:0;line-height:58rpx}.description>text:last-child{color:#66736b;line-height:1.8}.bottom{position:fixed;right:0;bottom:0;left:0;z-index:20;display:flex;gap:16rpx;padding:18rpx 24rpx;background:#fff}.bottom button{height:84rpx;margin:0;border-radius:42rpx;line-height:84rpx}.bottom .cart{width:180rpx;background:#eef5ef;color:#168a51}.bottom .primary{flex:1;background:#168a51;color:#fff}
