.orders-page { min-height: 100vh; }.order-tabs { position: sticky; top: 0; z-index: 10; width: 100%; background: var(--surface); white-space: nowrap; }.tabs-inner { display: inline-flex; min-width: 100%; justify-content: space-around; padding: 0 14rpx; }.order-tab { position: relative; padding: 28rpx 20rpx 24rpx; color: var(--muted); font-size: 24rpx; }.order-tab.active { color: var(--green); font-weight: 900; }.order-tab > text { display: none; position: absolute; left: 50%; bottom: 8rpx; width: 34rpx; height: 6rpx; transform: translateX(-50%); border-radius: 99rpx; background: var(--green); }.order-tab.active > text { display: block; }
.orders-list { padding: 22rpx 24rpx 170rpx; }.order-card { margin-bottom: 20rpx; padding: 26rpx; }.order-head { padding-bottom: 22rpx; border-bottom: 2rpx solid var(--line); }.order-head > view > text,.order-head > view > small { display: block; }.order-head > view > text { font-size: 22rpx; font-weight: 800; }.order-head > view > small { margin-top: 6rpx; color: var(--muted); font-size: 19rpx; }.status { font-size: 23rpx; font-weight: 900; }.status.wait_pay { color: #EA6035; }.status.shipping { color: var(--green); }.status.complete,.status.cancel { color: var(--muted); }
.order-products { display: flex; align-items: center; padding: 24rpx 0; }.order-products image { width: 124rpx; height: 124rpx; margin-right: 14rpx; border-radius: 20rpx; }.more-count { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 124rpx; border-radius: 20rpx; background: var(--page); color: var(--muted); }.order-summary { display: flex; align-items: flex-end; justify-content: flex-end; gap: 18rpx; padding-bottom: 22rpx; color: var(--muted); font-size: 19rpx; }.order-summary view { color: var(--ink); font-size: 22rpx; }.order-summary b { color: #ED5A37; font-size: 32rpx; }.order-actions { display: flex; justify-content: flex-end; gap: 14rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); }.order-actions button { min-width: 172rpx; height: 66rpx; margin: 0; padding: 0 22rpx; line-height: 64rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }.order-actions .light { border: 2rpx solid var(--line); background: transparent; color: var(--ink); }.order-actions .primary { background: var(--green); color: white; }
.no-orders { padding: 190rpx 20rpx; text-align: center; }.no-orders > view { display: flex; align-items: center; justify-content: center; width: 140rpx; height: 140rpx; margin: 0 auto 28rpx; border-radius: 50%; background: var(--green-soft); color: var(--green); font-size: 40rpx; font-weight: 900; }.no-orders > text,.no-orders > small { display: block; }.no-orders > text { font-size: 30rpx; font-weight: 900; }.no-orders > small { margin-top: 10rpx; color: var(--muted); }.no-orders button { width: 260rpx; height: 82rpx; margin-top: 38rpx; line-height: 82rpx; font-size: 25rpx; }.end { padding: 30rpx 0; color: #A8B2AC; text-align: center; font-size: 20rpx; }
.order-head .small { margin-top: 6rpx; font-size: 19rpx; }.order-summary .strong { display: inline; color: #ED5A37; font-size: 32rpx; }.no-orders .small { margin-top: 10rpx; }
