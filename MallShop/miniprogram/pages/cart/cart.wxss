.cart-page { padding-bottom: 210rpx; }.delivery-card { padding: 26rpx 26rpx 22rpx; background: linear-gradient(135deg, #E7F7ED, #F9FFF9); border: 2rpx solid #D4ECDE; }.delivery-title { display: flex; align-items: center; }.delivery-title > text { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-right: 16rpx; border-radius: 16rpx; background: var(--green); color: white; font-size: 20rpx; font-weight: 900; }.delivery-title b,.delivery-title small { display: block; }.delivery-title b { font-size: 25rpx; }.delivery-title small { margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }.go { color: var(--green); font-size: 21rpx; font-weight: 800; }.progress { height: 10rpx; overflow: hidden; margin-top: 22rpx; border-radius: 99rpx; background: #D4E7DB; }.progress view { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #52C782, #0C8549); transition: width .25s; }
.cart-actions { padding: 32rpx 6rpx 18rpx; color: var(--muted); font-size: 23rpx; }.select-row { display: flex; align-items: center; }.check { display: inline-flex; flex: 0 0 42rpx; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 14rpx; border: 2rpx solid #C8D2CC; border-radius: 14rpx; color: white; font-size: 22rpx; }.check.checked { border-color: var(--green); background: var(--green); }
.cart-item { display: flex; align-items: center; min-height: 210rpx; margin-bottom: 18rpx; padding: 20rpx; }.cart-item > image { flex: 0 0 152rpx; width: 152rpx; height: 152rpx; margin-right: 20rpx; border-radius: 22rpx; }.item-info { flex: 1; min-width: 0; align-self: stretch; padding: 4rpx 0; }.item-name { font-size: 27rpx; font-weight: 900; }.remove { color: #9DA9A2; font-size: 36rpx; line-height: 1; }.item-spec { margin-top: 12rpx; color: var(--muted); font-size: 21rpx; }.item-bottom { margin-top: 34rpx; }.item-bottom .price { font-size: 34rpx; }.item-bottom .price-symbol { font-size: 20rpx; }.stepper { display: flex; align-items: center; height: 58rpx; overflow: hidden; border-radius: 18rpx; background: var(--page); }.stepper button { width: 58rpx; height: 58rpx; margin: 0; padding: 0; line-height: 54rpx; border-radius: 0; background: transparent; color: var(--ink); font-size: 30rpx; }.stepper text { min-width: 48rpx; text-align: center; font-weight: 800; }
.empty-cart { padding-top: 180rpx; text-align: center; }.empty-bag { display: flex; align-items: center; justify-content: center; width: 150rpx; height: 150rpx; margin: 0 auto 30rpx; border-radius: 50%; background: var(--green-soft); color: var(--green); font-size: 42rpx; font-weight: 900; }.empty-title { font-size: 32rpx; font-weight: 900; }.empty-sub { margin-top: 12rpx; color: var(--muted); }.empty-cart button { width: 280rpx; height: 84rpx; margin-top: 42rpx; line-height: 84rpx; font-size: 27rpx; }
.checkout-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 18rpx 24rpx; border-top: 2rpx solid var(--line); background: var(--surface); box-shadow: 0 -12rpx 38rpx rgba(25,61,41,.08); }.checkout-inner { min-height: 94rpx; }.summary { font-size: 23rpx; }.summary text { color: #ED5A37; font-size: 40rpx; font-weight: 900; }.fee { margin-top: 4rpx; color: var(--muted); font-size: 20rpx; }.checkout-inner button { width: 290rpx; height: 88rpx; margin: 0; line-height: 88rpx; font-size: 27rpx; }.checkout-inner button.disabled { opacity: .45; box-shadow: none; }
.delivery-title .strong { font-size: 25rpx; }.delivery-title .small { margin-top: 6rpx; font-size: 20rpx; }
