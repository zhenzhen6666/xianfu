<view class="member-page">
  <view class="gold-card">
    <view class="gold-top between"><view><text>♛</text><text class="strong">鲜福{{user.memberLevelName}}</text></view><text>NO. {{user.id}}</text></view>
    <view class="hello">{{user.nickname}}，您好</view>
    <view class="growth between"><view><text class="small">累计消费</text><text class="strong">¥{{user.totalSpent}}</text></view><view class="growth-right"><view><text></text></view><text class="small">{{nextLevelText}}</text></view></view>
    <view class="levels"><text class="{{user.memberLevelCode === 'NORMAL' ? 'active' : ''}}">普通</text><text class="{{user.memberLevelCode === 'SILVER' ? 'active' : ''}}">银卡</text><text class="{{user.memberLevelCode === 'GOLD' ? 'active' : ''}}">金卡</text><text class="{{user.memberLevelCode === 'DIAMOND' ? 'active' : ''}}">钻石</text></view>
  </view>
  <view class="member-content">
    <view class="section-title">我的会员权益</view><view class="section-kicker">等级越高，生活越鲜省</view>
    <view class="rights card"><view wx:for="{{rights}}" wx:key="name"><text>{{item.icon}}</text><text class="strong">{{item.name}}</text><text class="small">{{item.desc}}</text></view></view>
    <view class="points-card card between" bindtap="goPoints"><view><text class="small">可用积分</text><text class="strong">{{pointsBalance}}</text><text>积分余额来自 Java 服务端</text></view><view class="points-go">积分明细 ›</view></view>
    <view class="coupon-head between"><view><view class="section-title">我的优惠券卡包</view><view class="section-kicker">优惠券状态实时同步</view></view><text>{{coupons.length}} 张</text></view>
    <view class="coupon" wx:for="{{coupons}}" wx:key="id"><view class="amount"><text class="small">¥</text><text class="strong">{{item.amount}}</text></view><view class="coupon-info"><text class="strong">{{item.name}}</text><text class="small">{{item.condition}} · {{item.date}}</text></view><button data-status="{{item.status}}" disabled="{{item.status !== 'AVAILABLE'}}" bindtap="useCoupon">{{item.status === 'AVAILABLE' ? '去使用' : item.date}}</button></view>
    <view class="rule card"><text class="strong">积分与升级规则</text><text>· 每消费 1 元可获得 1 积分，金卡会员享双倍积分</text><text>· 累计消费自动升级，成长值长期有效</text><text>· 积分可在结算页抵扣订单现金</text></view>
  </view>
</view>
