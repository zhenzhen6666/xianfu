.member-page { min-height: 100vh; padding: 26rpx 24rpx 100rpx; background: linear-gradient(180deg,#13271B 0,#1F3A2A 430rpx,var(--page) 431rpx); }.gold-card { position: relative; overflow: hidden; min-height: 350rpx; padding: 32rpx; border: 2rpx solid rgba(255,230,172,.5); border-radius: 36rpx; background: linear-gradient(135deg,#E5B85C,#FFF0B8 45%,#D7A949); color: #3A2B13; box-shadow: 0 22rpx 50rpx rgba(0,0,0,.28); }.gold-card::after { content: '♛'; position: absolute; right: -32rpx; top: 20rpx; color: rgba(87,59,16,.08); font-size: 260rpx; }.gold-top { position: relative; z-index: 2; }.gold-top > view { display: flex; align-items: center; }.gold-top > view text { margin-right: 12rpx; font-size: 34rpx; }.gold-top > view b { font-size: 29rpx; }.gold-top > text { font-size: 18rpx; opacity: .6; }.hello { position: relative; z-index: 2; margin-top: 34rpx; font-size: 23rpx; }.growth { position: relative; z-index: 2; margin-top: 20rpx; }.growth small,.growth b { display: block; }.growth b { margin-top: 4rpx; font-size: 48rpx; }.growth-right { flex: 1; margin-left: 40rpx; }.growth-right > view { height: 10rpx; border-radius: 99rpx; background: rgba(65,42,10,.14); }.growth-right > view text { display: block; width: 72%; height: 100%; border-radius: 99rpx; background: #5C4219; }.growth-right small { margin-top: 10rpx; font-size: 18rpx; }.levels { position: relative; z-index: 2; display: flex; justify-content: space-between; margin-top: 26rpx; padding-top: 18rpx; border-top: 2rpx solid rgba(64,42,11,.12); font-size: 18rpx; }.levels .active { font-weight: 900; }
.member-content { padding-top: 48rpx; }.rights { display: grid; grid-template-columns: repeat(4,1fr); margin-top: 24rpx; padding: 28rpx 8rpx; }.rights view { text-align: center; }.rights view > text { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0 auto 12rpx; border-radius: 22rpx; background: #FFF1D3; color: #A16A12; font-size: 20rpx; font-weight: 900; }.rights b,.rights small { display: block; }.rights b { font-size: 21rpx; }.rights small { margin-top: 6rpx; color: var(--muted); font-size: 17rpx; }.points-card { margin-top: 20rpx; padding: 28rpx; }.points-card small,.points-card b,.points-card text { display: block; }.points-card > view:first-child small { color: var(--muted); }.points-card > view:first-child b { margin-top: 4rpx; font-size: 40rpx; }.points-card > view:first-child text { margin-top: 6rpx; color: var(--muted); font-size: 19rpx; }.points-go { padding: 14rpx 20rpx; border-radius: 99rpx; background: var(--green-soft); color: var(--green); font-size: 21rpx; font-weight: 800; }.coupon-head { margin: 46rpx 4rpx 20rpx; }.coupon-head > text { color: #A9771E; font-size: 20rpx; }.coupon { display: flex; align-items: center; min-height: 150rpx; margin-bottom: 16rpx; padding: 20rpx 22rpx; border-radius: 26rpx; background: linear-gradient(90deg,#FFF4DA,#FFF); border-left: 8rpx solid #E4B553; }.amount { width: 120rpx; color: #A76912; }.amount small { font-size: 20rpx; }.amount b { font-size: 50rpx; }.coupon-info { flex: 1; }.coupon-info b,.coupon-info small { display: block; }.coupon-info b { font-size: 25rpx; }.coupon-info small { margin-top: 9rpx; color: #8B7655; font-size: 18rpx; }.coupon button { width: 112rpx; height: 58rpx; padding: 0; line-height: 58rpx; border-radius: 99rpx; background: #A9771E; color: white; font-size: 21rpx; }.rule { margin-top: 28rpx; padding: 28rpx; }.rule b,.rule text { display: block; }.rule b { margin-bottom: 16rpx; }.rule text { margin-top: 10rpx; color: var(--muted); font-size: 20rpx; line-height: 1.6; }
.gold-top .strong { display: inline; font-size: 29rpx; }.growth .strong { margin-top: 4rpx; font-size: 48rpx; }.growth-right .small { margin-top: 10rpx; color: #3A2B13; font-size: 18rpx; }.rights .strong,.rights .small { display: block; width: auto; height: auto; margin: 0; background: transparent; }.rights .strong { font-size: 21rpx; }.rights .small { margin-top: 6rpx; font-size: 17rpx; }.points-card .strong { margin-top: 4rpx; font-size: 40rpx; }.amount .small,.amount .strong { display: inline; color: #A76912; }.amount .strong { font-size: 50rpx; }.coupon-info .strong { font-size: 25rpx; }.coupon-info .small { margin-top: 9rpx; color: #8B7655; font-size: 18rpx; }.rule .strong { margin-bottom: 16rpx; }
