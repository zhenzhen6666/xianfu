.home { padding-top: 16rpx; }
.service-row { padding: 6rpx 4rpx 22rpx; }
.location { font-size: 30rpx; font-weight: 900; }
.pin { color: var(--green); font-size: 18rpx; margin-right: 12rpx; }
.chevron { color: var(--muted); margin-left: 10rpx; }
.arrival { display: block; color: var(--muted); font-size: 22rpx; margin: 8rpx 0 0 30rpx; }
.share-btn { width: 70rpx; height: 70rpx; padding: 0; line-height: 70rpx; border-radius: 24rpx; background: #fff; font-size: 34rpx; color: var(--green-dark); }
.search-wrap { height: 92rpx; padding: 10rpx 12rpx 10rpx 28rpx; background: var(--surface); border-radius: 28rpx; }
.search-icon { font-size: 38rpx; color: var(--green); margin-right: 12rpx; }
.search-wrap input { flex: 1; font-size: 27rpx; }
.search-wrap button { margin: 0; padding: 0 28rpx; min-width: 104rpx; height: 68rpx; line-height: 68rpx; border-radius: 22rpx; background: var(--green); color: #fff; font-weight: 700; font-size: 25rpx; }
.hero { position: relative; overflow: hidden; height: 336rpx; margin-top: 28rpx; padding: 38rpx 30rpx; color: white; background: linear-gradient(135deg, #0B673B, #1DA964); }
.hero::after { content: ''; position: absolute; width: 300rpx; height: 300rpx; right: -100rpx; top: -110rpx; border-radius: 50%; background: rgba(255,255,255,.1); }
.hero-copy { position: relative; z-index: 3; width: 64%; }
.eyebrow { display: inline-block; padding: 8rpx 16rpx; background: rgba(255,255,255,.16); border-radius: 99rpx; font-size: 20rpx; letter-spacing: 2rpx; }
.hero-title { margin-top: 20rpx; font-size: 44rpx; line-height: 1.15; font-weight: 900; }
.hero-title text { display: block; color: #FFF09D; }
.hero-sub { margin-top: 12rpx; font-size: 23rpx; opacity: .86; }
.hero-btn { width: 204rpx; height: 62rpx; padding: 0; margin: 22rpx 0 0; line-height: 62rpx; border-radius: 99rpx; background: #fff; color: var(--green-dark); font-size: 23rpx; font-weight: 800; }
.hero-images { position: absolute; right: -44rpx; bottom: -34rpx; z-index: 2; width: 295rpx; height: 270rpx; transform: rotate(-4deg); }
.hero-img { position: absolute; width: 210rpx; height: 210rpx; border-radius: 50%; border: 10rpx solid rgba(255,255,255,.8); }
.hero-img.one { right: 48rpx; bottom: 10rpx; }.hero-img.two { width: 120rpx; height: 120rpx; right: 0; top: 0; }
.hero-bubble { position: absolute; right: 232rpx; top: 36rpx; z-index: 4; width: 54rpx; height: 54rpx; line-height: 54rpx; text-align: center; border-radius: 50%; color: var(--green-dark); background: #FFF09D; font-weight: 900; transform: rotate(-8deg); }
.notice { margin: 24rpx 0; padding: 20rpx 24rpx; border-radius: 22rpx; background: #EBF8EF; color: #426153; font-size: 23rpx; }
.notice-icon { display: inline-flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 14rpx; border-radius: 14rpx; background: var(--green); color: white; font-size: 20rpx; font-weight: 900; }
.notice-main { color: var(--green-dark); font-weight: 800; }.notice-dot { margin: 0 10rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); padding: 28rpx 12rpx 24rpx; }
.quick-item { text-align: center; font-size: 23rpx; font-weight: 700; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; margin: 0 auto 14rpx; border-radius: 28rpx; font-size: 23rpx; font-weight: 900; }
.quick-icon.mint { background: #DFF5E7; color: #0A7B45; }.quick-icon.orange { background: #FFE6D7; color: #E85D25; }.quick-icon.pink { background: #FFE7EC; color: #D84B70; }.quick-icon.yellow { background: #FFF0B9; color: #A26700; }
.zone-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.zone { position: relative; overflow: hidden; height: 220rpx; padding: 26rpx; border-radius: 28rpx; }
.zone-pink { background: #FFE8E7; }.zone-yellow { background: #FFF2CD; }.zone-mint { background: #E6F6EC; }.zone-orange { background: #FFE9DA; }
.zone-kicker { font-size: 20rpx; color: #8B665C; }.zone-title { margin-top: 6rpx; font-size: 32rpx; font-weight: 900; }.zone-link { margin-top: 22rpx; font-size: 21rpx; font-weight: 700; }
.zone image { position: absolute; width: 140rpx; height: 140rpx; border-radius: 50%; right: -18rpx; bottom: -18rpx; }
.section-head { margin: 54rpx 4rpx 24rpx; }.more { color: var(--green); font-size: 25rpx; font-weight: 700; }.more text { font-size: 36rpx; }
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.product-card { overflow: hidden; }.product-media { position: relative; height: 260rpx; background: #F0F3F0; }.product-media image { width: 100%; height: 100%; }
.product-badge { position: absolute; left: 14rpx; top: 14rpx; padding: 6rpx 12rpx; border-radius: 12rpx; background: rgba(8,103,59,.9); color: white; font-size: 19rpx; font-weight: 700; }
.product-info { padding: 20rpx; }.product-name { font-size: 28rpx; font-weight: 800; }.product-spec { height: 36rpx; margin-top: 8rpx; color: var(--muted); font-size: 21rpx; }
.product-bottom { margin-top: 16rpx; }.product-bottom .price { font-size: 34rpx; }.product-bottom .price-symbol { font-size: 21rpx; }
.add-btn { width: 54rpx; height: 54rpx; padding: 0; margin: 0; line-height: 50rpx; border-radius: 18rpx; background: var(--green); color: white; font-size: 38rpx; font-weight: 400; }
.cart-float { position: fixed; z-index: 9; right: 28rpx; bottom: calc(140rpx + env(safe-area-inset-bottom)); padding: 20rpx 26rpx; border-radius: 999rpx; background: #173126; color: #fff; font-weight: 800; }
.cart-count { position: absolute; right: -6rpx; top: -12rpx; min-width: 38rpx; height: 38rpx; padding: 0 8rpx; line-height: 38rpx; border-radius: 99rpx; background: #FF603D; font-size: 20rpx; text-align: center; }
.guide-mask { position: fixed; z-index: 99; inset: 0; display: flex; align-items: flex-end; background: rgba(7,28,17,.58); }
.guide-card { width: 100%; padding: 46rpx 42rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 44rpx 44rpx 0 0; background: var(--surface); }
.guide-mark { width: 84rpx; height: 84rpx; margin: -88rpx auto 24rpx; line-height: 84rpx; border: 10rpx solid var(--surface); border-radius: 50%; background: var(--green); color: white; text-align: center; font-size: 38rpx; font-weight: 900; }
.guide-title { text-align: center; font-size: 38rpx; font-weight: 900; }.guide-sub { margin-top: 10rpx; text-align: center; color: var(--muted); }
.guide-steps { margin: 36rpx 0; }.guide-steps > view { display: flex; align-items: center; margin: 24rpx 0; }
.guide-steps > view > text { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-right: 22rpx; border-radius: 16rpx; background: var(--green-soft); color: var(--green); font-weight: 900; }
.guide-steps b, .guide-steps small { display: block; }.guide-steps b { font-size: 27rpx; }.guide-steps small { margin-top: 4rpx; color: var(--muted); font-size: 22rpx; }
.guide-btn { height: 92rpx; line-height: 92rpx; font-size: 28rpx; }
.guide-steps .strong { font-size: 27rpx; }.guide-steps .small { margin-top: 4rpx; font-size: 22rpx; }
