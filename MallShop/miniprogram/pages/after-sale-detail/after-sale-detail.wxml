<view class="detail-page" wx:if="{{item}}"><view class="status-card"><text class="status">{{item.refundStatus==='SUCCEEDED'?'退款成功':item.refundStatus==='FAILED'?'退款失败，商家处理中':item.status==='REJECTED'?'申请已拒绝':'售后处理中'}}</text><text>申请退款 ¥{{item.refundAmount}} · 已退款 ¥{{item.refundedAmount}}</text><text class="error" wx:if="{{item.refundError}}">{{item.refundError}}</text></view><view class="card"><view><text class="label">售后编号</text><text>{{item.afterSaleNo}}</text></view><view><text class="label">订单编号</text><text>{{item.orderNo}}</text></view><view><text class="label">申请原因</text><text>{{item.reason}}</text></view><view><text class="label">问题描述</text><text>{{item.description||'无补充说明'}}</text></view><view wx:if="{{item.merchantReply}}"><text class="label">商家回复</text><text>{{item.merchantReply}}</text></view></view><view class="card" wx:if="{{item.images.length}}"><text class="title">图片凭证</text><view class="images"><image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" data-url="{{item}}" bindtap="preview" mode="aspectFill"/></view></view><view class="card"><text class="title">退款进度</text><view class="step" wx:for="{{item.history}}" wx:key="createdAt"><text class="dot">●</text><view><strong>{{item.message}}</strong><text>{{item.createdAt}}</text><text>售后状态 {{item.status}} · 退款状态 {{item.refundStatus}}</text></view></view></view></view>
