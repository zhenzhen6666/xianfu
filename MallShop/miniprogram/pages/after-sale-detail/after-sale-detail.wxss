.detail-page{min-height:100vh;padding:24rpx;background:#f5f7f5}.status-card,.card{display:flex;flex-direction:column;gap:20rpx;margin-bottom:20rpx;padding:30rpx;background:#fff;border-radius:24rpx}.status-card{color:#fff;background:linear-gradient(135deg,#168a51,#48a973)}.status{font-size:38rpx;font-weight:800}.error{padding:14rpx;color:#8d2c20;background:rgba(255,255,255,.8);border-radius:12rpx}.card>view{display:flex;justify-content:space-between;gap:30rpx}.label{color:#819087}.title{font-weight:800}.images{display:grid!important;grid-template-columns:repeat(3,1fr);gap:12rpx}.images image{width:100%;height:190rpx;border-radius:14rpx}.step{justify-content:flex-start!important}.dot{color:#168a51}.step view{display:flex;flex-direction:column;gap:8rpx}.step view text{color:#87928b;font-size:22rpx}
