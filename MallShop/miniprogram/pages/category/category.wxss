.category-page { height: calc(100vh - env(safe-area-inset-bottom)); overflow: hidden; }
.category-top { padding: 20rpx 24rpx 16rpx; background: var(--surface); }
.search-box { height: 82rpx; padding: 0 24rpx; border-radius: 24rpx; background: var(--page); }
.search-box > text:first-child { color: var(--green); font-size: 36rpx; margin-right: 12rpx; }.search-box input { flex: 1; }.search-box .clear { color: var(--muted); font-size: 34rpx; }
.filter-scroll { width: 100%; margin-top: 18rpx; white-space: nowrap; }.filters { display: inline-flex; gap: 14rpx; }
.filter { padding: 13rpx 23rpx; border: 2rpx solid transparent; border-radius: 999rpx; background: var(--page); color: var(--muted); font-size: 22rpx; }
.filter.active { border-color: var(--green); background: var(--green-soft); color: var(--green); font-weight: 800; }
.catalog { display: flex; height: calc(100vh - 220rpx - env(safe-area-inset-bottom)); }
.category-list { width: 176rpx; height: 100%; background: #EEF3EF; }
.category-item { position: relative; display: flex; align-items: center; justify-content: center; min-height: 104rpx; padding: 18rpx 12rpx; color: #637269; text-align: center; font-size: 24rpx; }
.category-item.active { background: var(--surface); color: var(--ink); font-weight: 900; }.active-line { display: none; position: absolute; left: 0; width: 8rpx; height: 40rpx; border-radius: 0 8rpx 8rpx 0; background: var(--green); }.category-item.active .active-line { display: block; }
.goods-list { flex: 1; height: 100%; padding: 0 20rpx 160rpx; }
.goods-head { padding: 26rpx 4rpx 20rpx; }.goods-head > view > text { display: block; font-size: 30rpx; font-weight: 900; }.goods-head small { display: block; margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }.fresh { color: var(--green); font-size: 20rpx; }
.goods-card { display: flex; min-height: 218rpx; margin-bottom: 16rpx; padding: 16rpx; }
.goods-card > image { flex: 0 0 180rpx; width: 180rpx; height: 186rpx; border-radius: 22rpx; background: #EEF2EF; }
.goods-info { position: relative; flex: 1; min-width: 0; padding: 4rpx 0 2rpx 18rpx; }.goods-name { font-size: 28rpx; font-weight: 900; }.goods-sub { max-width: 290rpx; margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #52635A; font-size: 21rpx; }.goods-spec { margin-top: 10rpx; color: var(--muted); font-size: 19rpx; }
.goods-price-row { position: absolute; left: 18rpx; right: 0; bottom: 0; }.goods-price-row .price { font-size: 34rpx; }.goods-price-row .price-symbol { font-size: 20rpx; }.original { margin-left: 8rpx; color: #9FA9A3; text-decoration: line-through; font-size: 19rpx; }
.add { width: 54rpx; height: 54rpx; margin: 0; padding: 0; line-height: 50rpx; border-radius: 18rpx; background: var(--green); color: white; font-size: 36rpx; }
.empty { padding: 160rpx 20rpx; color: var(--muted); text-align: center; }.empty > text { font-size: 72rpx; opacity: .4; }.empty view { margin-top: 20rpx; color: var(--ink); font-weight: 800; }.empty small { display: block; margin-top: 10rpx; font-size: 22rpx; }.list-end { padding: 38rpx 0 60rpx; color: #ABB5AF; font-size: 20rpx; text-align: center; }
.cart-float { position: fixed; right: 26rpx; bottom: calc(138rpx + env(safe-area-inset-bottom)); z-index: 10; display: flex; align-items: center; padding: 16rpx 22rpx 16rpx 14rpx; border-radius: 999rpx; background: #173126; color: white; font-size: 23rpx; font-weight: 800; }.cart-icon { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; margin-right: 10rpx; border-radius: 50%; background: var(--green); font-size: 20rpx; }.count { position: absolute; right: -8rpx; top: -12rpx; min-width: 38rpx; height: 38rpx; padding: 0 7rpx; line-height: 38rpx; border-radius: 99rpx; background: #FF5D3D; text-align: center; font-size: 19rpx; }
.modal-mask { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-end; background: rgba(7,28,17,.55); }.product-sheet { width: 100%; overflow: hidden; border-radius: 42rpx 42rpx 0 0; background: var(--surface); }.sheet-image { width: 100%; height: 480rpx; }.sheet-body { padding: 30rpx 34rpx 34rpx; }.sheet-title { font-size: 36rpx; font-weight: 900; }.sheet-close { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; background: var(--page); font-size: 36rpx; }.sheet-sub { margin-top: 8rpx; color: var(--muted); }.sheet-tags { display: flex; gap: 12rpx; margin: 22rpx 0; }.sheet-tags text { padding: 8rpx 13rpx; border-radius: 10rpx; background: var(--green-soft); color: var(--green-dark); font-size: 20rpx; }.sheet-spec { padding: 24rpx; border-radius: 20rpx; background: var(--page); }.sheet-spec .label { margin-right: 24rpx; font-weight: 800; }.sheet-spec > text { color: var(--green); }.sheet-footer { margin-top: 28rpx; }.sheet-price { font-size: 44rpx; }.member-price { display: block; margin-top: 4rpx; color: #AA7A26; font-size: 20rpx; }.sheet-footer button { width: 260rpx; height: 84rpx; line-height: 84rpx; font-size: 26rpx; }
.goods-head .small,.empty .small { margin-top: 5rpx; font-size: 20rpx; }
