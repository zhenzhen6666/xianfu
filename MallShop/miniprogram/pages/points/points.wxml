<view class="asset-page">
  <view class="points-head"><text>可用积分</text><strong>{{balance}}</strong><text>100 积分可抵 1 元</text></view>
  <view class="asset-card record" wx:for="{{records}}" wx:key="createdAt">
    <view class="grow"><text class="title">{{item.remark||item.transactionType}}</text><text class="muted">{{item.createdAt}}</text><text class="muted">余额 {{item.balanceAfter}}</text></view>
    <text class="{{item.changeAmount>0?'plus':'minus'}}">{{item.changeAmount>0?'+':''}}{{item.changeAmount}}</text>
  </view>
  <view class="empty" wx:if="{{!loading && !records.length}}">暂无积分变动</view>
</view>
