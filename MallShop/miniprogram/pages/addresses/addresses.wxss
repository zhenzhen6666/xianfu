.address-page{min-height:100vh;padding:24rpx 24rpx 150rpx;background:#f5f7f5}.address-card{margin-bottom:20rpx;padding:28rpx;background:#fff;border-radius:24rpx}.top{display:flex;align-items:center;gap:18rpx}.name{font-size:31rpx;font-weight:800}.default{padding:4rpx 10rpx;color:#168a51;background:#eaf7ee;border-radius:8rpx;font-size:20rpx}.detail{display:block;margin:18rpx 0;color:#56645b}.actions{display:flex;justify-content:space-between;padding-top:18rpx;border-top:1rpx solid #edf0ed;color:#758078;font-size:24rpx}.actions view{display:flex;gap:30rpx}.add{position:fixed;right:30rpx;bottom:38rpx;left:30rpx;background:#168a51;color:#fff;border-radius:44rpx}.empty{padding:120rpx;text-align:center;color:#879188}.mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(0,0,0,.45)}.sheet{width:100%;padding:30rpx;background:#fff;border-radius:34rpx 34rpx 0 0}.head{display:flex;justify-content:space-between;margin-bottom:25rpx;font-size:32rpx}.sheet label{display:flex;flex-direction:column;gap:12rpx;margin-bottom:20rpx;color:#657168;font-size:24rpx}.sheet input,.sheet textarea{box-sizing:border-box;width:100%;padding:20rpx;background:#f5f7f5;border-radius:16rpx;color:#23332a}.switch{flex-direction:row!important;align-items:center;justify-content:space-between}.save{background:#168a51;color:#fff;border-radius:40rpx}
