.activity-page { min-height: 100vh; padding-bottom: 100rpx; background: #FFF7EE; }.activity-page.green { background: #F0FAF4; }.activity-page.pink { background: #FFF3F5; }.activity-page.yellow { background: #FFF8DD; }.activity-hero { position: relative; overflow: hidden; height: 430rpx; padding: 48rpx 32rpx; color: white; background: linear-gradient(135deg,#E75C32,#FF9B55); }.green .activity-hero { background: linear-gradient(135deg,#087440,#24AC6B); }.pink .activity-hero { background: linear-gradient(135deg,#C94C73,#F18BA1); }.yellow .activity-hero { background: linear-gradient(135deg,#CA8B0B,#F2B83D); }.activity-label { position: relative; z-index: 2; display: inline-block; padding: 8rpx 15rpx; border-radius: 99rpx; background: rgba(255,255,255,.16); font-size: 20rpx; }.activity-title { position: relative; z-index: 2; margin-top: 28rpx; font-size: 54rpx; font-weight: 900; letter-spacing: -2rpx; }.activity-sub { position: relative; z-index: 2; margin-top: 10rpx; font-size: 27rpx; }.activity-rule { position: relative; z-index: 2; display: inline-block; margin-top: 30rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: white; color: #C84E2B; font-size: 20rpx; font-weight: 800; }.green .activity-rule { color: var(--green); }.activity-hero image { position: absolute; z-index: 1; right: -60rpx; bottom: -50rpx; width: 340rpx; height: 340rpx; border: 14rpx solid rgba(255,255,255,.65); border-radius: 50%; transform: rotate(-8deg); }.shape { position: absolute; right: 170rpx; top: 42rpx; width: 80rpx; height: 80rpx; border: 14rpx solid rgba(255,255,255,.12); border-radius: 50%; }
.activity-body { padding: 34rpx 24rpx; }.body-head { margin-bottom: 24rpx; }.body-head > text { padding: 9rpx 14rpx; border-radius: 12rpx; background: rgba(255,255,255,.65); color: #D65A34; font-size: 18rpx; font-weight: 800; }.activity-item { display: flex; min-height: 230rpx; margin-bottom: 18rpx; padding: 16rpx; }.activity-item > image { width: 198rpx; height: 198rpx; margin-right: 20rpx; border-radius: 24rpx; }.item-main { position: relative; flex: 1; min-width: 0; padding-top: 2rpx; }.badge { display: inline-block; padding: 5rpx 10rpx; border-radius: 8rpx; background: #FFE9DE; color: #E35D32; font-size: 18rpx; }.item-name { margin-top: 9rpx; font-size: 29rpx; font-weight: 900; }.item-spec { margin-top: 8rpx; color: var(--muted); font-size: 19rpx; }.item-bottom { position: absolute; left: 0; right: 0; bottom: 2rpx; }.item-bottom .price { font-size: 38rpx; }.item-bottom .price-symbol { font-size: 20rpx; }.old { margin-left: 8rpx; color: #9EA8A2; font-size: 18rpx; text-decoration: line-through; }.item-bottom button { width: 70rpx; height: 60rpx; margin: 0; padding: 0; line-height: 60rpx; border-radius: 20rpx; background: #ED6035; color: white; font-size: 24rpx; font-weight: 900; }.egg-box { display: flex; align-items: center; margin: -54rpx 24rpx 0; padding: 24rpx; position: relative; z-index: 3; }.egg { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 120rpx; margin-right: 24rpx; border-radius: 52% 52% 48% 48%; background: linear-gradient(135deg,#FFD96E,#EBAF24); color: #9A5E00; font-size: 30rpx; font-weight: 900; box-shadow: inset 0 0 0 8rpx rgba(255,255,255,.25); }.egg.opened { border-radius: 28rpx; background: #FFE6D9; color: #E05D34; }.egg-box b,.egg-box small { display: block; }.egg-box b { font-size: 27rpx; }.egg-box small { margin-top: 8rpx; color: var(--muted); font-size: 21rpx; }.activity-cart { position: fixed; z-index: 10; right: 28rpx; bottom: calc(38rpx + env(safe-area-inset-bottom)); padding: 20rpx 28rpx; border-radius: 99rpx; background: #173126; color: white; font-weight: 800; box-shadow: 0 12rpx 30rpx rgba(0,0,0,.22); }.activity-cart text { position: absolute; right: -8rpx; top: -13rpx; min-width: 38rpx; height: 38rpx; padding: 0 7rpx; line-height: 38rpx; border-radius: 99rpx; background: #FF653F; font-size: 19rpx; text-align: center; }
.egg-box .strong { font-size: 27rpx; }.egg-box .small { margin-top: 8rpx; font-size: 21rpx; }
