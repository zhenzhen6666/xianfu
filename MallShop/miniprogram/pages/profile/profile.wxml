<view class="profile-page page-shell">
  <view class="profile-head">
    <view class="avatar">{{avatarText}}<text></text></view>
    <view class="user-info"><view>{{user.nickname}}</view><text bindtap="goMember">{{user.memberLevelName}} <text class="strong">›</text></text></view>
    <button open-type="share">↗</button>
  </view>
  <view class="card mobile-bind" wx:if="{{!user.mobile}}">
    <text>绑定微信手机号后可接收管理员发放的优惠券</text>
    <button open-type="getPhoneNumber" bindgetphonenumber="bindMobile">立即绑定</button>
  </view>

  <view class="member-card" bindtap="goMember">
    <view class="member-top between"><view><text class="crown">♛</text><text>鲜福{{user.memberLevelName}}</text></view><text>会员中心 ›</text></view>
    <view class="member-main between"><view><text class="small">累计消费</text><text class="strong">¥{{user.totalSpent}}</text></view><view class="upgrade"><view><text></text></view><text class="small">消费金额由服务端实时累计</text></view></view>
    <view class="member-rights"><text>会员专享价</text><text>双倍积分</text><text>每月券包</text></view>
  </view>

  <view class="orders-card card">
    <view class="orders-title between"><text>我的订单</text><text data-status="all" bindtap="goOrders">全部订单 ›</text></view>
    <view class="order-shortcuts">
      <view data-status="wait_pay" bindtap="goOrders"><text>付</text><text class="strong">待支付</text></view>
      <view data-status="fulfilling" bindtap="goOrders"><text>送</text><text class="strong">履约中</text></view>
      <view data-status="complete" bindtap="goOrders"><text>收</text><text class="strong">已完成</text></view>
      <view bindtap="goAfterSales"><text>售</text><text class="strong">退款/售后</text></view>
    </view>
  </view>

  <view class="asset-row card">
    <view><text class="strong">{{couponCount}}</text><text>优惠券</text></view><view><text class="strong">{{user.points}}</text><text>可用积分</text></view><view><text class="strong">{{favoriteCount}}</text><text>收藏商品</text></view>
  </view>

  <view class="menu-card card">
    <view class="menu-item" wx:for="{{menus}}" wx:key="name" data-action="{{item.action}}" bindtap="menuTap">
      <text class="menu-icon">{{item.icon}}</text><text class="menu-name">{{item.name}}</text><text class="menu-value">{{item.value}}</text><text class="menu-arrow">›</text>
    </view>
  </view>
  <view class="service-note">鲜福铺 · 让新鲜离家更近</view>
</view>
