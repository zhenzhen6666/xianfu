.profile-page { padding-top: 28rpx; background: linear-gradient(180deg, #E8F6EE 0, var(--page) 460rpx); }.profile-head { display: flex; align-items: center; padding: 12rpx 8rpx 30rpx; }.avatar { position: relative; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin-right: 20rpx; border: 6rpx solid rgba(255,255,255,.8); border-radius: 40rpx; background: linear-gradient(135deg, #FFC87B, #FF8B5A); color: white; font-size: 44rpx; font-weight: 900; box-shadow: 0 12rpx 26rpx rgba(168,90,45,.18); }.avatar text { position: absolute; right: -3rpx; bottom: -3rpx; width: 28rpx; height: 28rpx; border: 5rpx solid white; border-radius: 50%; background: #22B267; }.user-info { flex: 1; }.user-info view { font-size: 36rpx; font-weight: 900; }.user-info > text { display: inline-flex; align-items: center; margin-top: 9rpx; padding: 7rpx 14rpx; border-radius: 99rpx; background: #173126; color: #FFDFA3; font-size: 20rpx; }.user-info b { margin-left: 8rpx; }.profile-head button { width: 66rpx; height: 66rpx; margin: 0; padding: 0; line-height: 66rpx; border-radius: 22rpx; background: rgba(255,255,255,.7); color: var(--green-dark); font-size: 30rpx; }
.member-card { position: relative; overflow: hidden; min-height: 276rpx; padding: 30rpx; border-radius: 30rpx; background: linear-gradient(135deg, #173126, #315541); color: white; box-shadow: 0 18rpx 38rpx rgba(15,54,32,.22); }.member-card::after { content: '♛'; position: absolute; right: -20rpx; top: -60rpx; color: rgba(255,223,163,.08); font-size: 240rpx; }.member-top { position: relative; z-index: 2; }.member-top > view { font-size: 28rpx; font-weight: 900; }.crown { margin-right: 12rpx; color: #FFDFA3; }.member-top > text { color: #FFDFA3; font-size: 21rpx; }.member-main { position: relative; z-index: 2; margin-top: 30rpx; }.member-main > view:first-child small,.member-main > view:first-child b { display: block; }.member-main > view:first-child small { color: rgba(255,255,255,.65); font-size: 19rpx; }.member-main > view:first-child b { margin-top: 3rpx; color: #FFDFA3; font-size: 38rpx; }.upgrade { flex: 1; margin-left: 34rpx; }.upgrade > view { height: 10rpx; overflow: hidden; border-radius: 99rpx; background: rgba(255,255,255,.16); }.upgrade > view text { display: block; width: 72%; height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #FFDFA3, #F2BE69); }.upgrade small { display: block; margin-top: 10rpx; color: rgba(255,255,255,.65); font-size: 18rpx; }.member-rights { position: relative; z-index: 2; display: flex; gap: 14rpx; margin-top: 24rpx; }.member-rights text { padding: 8rpx 14rpx; border-radius: 99rpx; background: rgba(255,255,255,.1); color: #FFE7B8; font-size: 18rpx; }
.orders-card,.asset-row,.menu-card { margin-top: 20rpx; }.orders-card { padding: 26rpx; }.orders-title { padding-bottom: 24rpx; border-bottom: 2rpx solid var(--line); }.orders-title text:first-child { font-size: 28rpx; font-weight: 900; }.orders-title text:last-child { color: var(--muted); font-size: 21rpx; }.order-shortcuts { display: grid; grid-template-columns: repeat(4,1fr); padding-top: 26rpx; }.order-shortcuts view { text-align: center; }.order-shortcuts text { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0 auto 12rpx; border-radius: 20rpx; background: var(--green-soft); color: var(--green); font-weight: 900; }.order-shortcuts b { display: block; font-size: 21rpx; font-weight: 700; }.asset-row { display: grid; grid-template-columns: repeat(3,1fr); padding: 24rpx 0; }.asset-row view { text-align: center; border-right: 2rpx solid var(--line); }.asset-row view:last-child { border: 0; }.asset-row b,.asset-row text { display: block; }.asset-row b { font-size: 30rpx; }.asset-row text { margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }
.menu-card { display: grid; grid-template-columns: 1fr 1fr; padding: 12rpx 24rpx; }.menu-item { display: flex; align-items: center; min-height: 92rpx; border-bottom: 2rpx solid var(--line); }.menu-item:nth-last-child(-n+2) { border: 0; }.menu-item:nth-child(odd) { margin-right: 18rpx; }.menu-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 12rpx; border-radius: 15rpx; background: var(--page); color: var(--green); font-size: 19rpx; font-weight: 900; }.menu-name { flex: 1; font-size: 22rpx; font-weight: 700; }.menu-value { color: #ED6B42; font-size: 18rpx; }.menu-arrow { margin-left: 6rpx; color: #A8B2AC; font-size: 30rpx; }.service-note { padding: 44rpx 0 12rpx; color: #9BA7A0; text-align: center; font-size: 20rpx; }
.user-info .strong { display: inline; margin-left: 8rpx; }.member-main .small,.member-main .strong,.upgrade .small { display: block; }.member-main .strong { margin-top: 3rpx; color: #FFDFA3; font-size: 38rpx; }.upgrade .small { margin-top: 10rpx; color: rgba(255,255,255,.65); font-size: 18rpx; }.order-shortcuts .strong { font-size: 21rpx; }.asset-row .strong { font-size: 30rpx; }
.mobile-bind{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:22rpx;padding:22rpx 26rpx;color:#5d6c63;font-size:24rpx}.mobile-bind button{margin:0;padding:0 22rpx;background:#168a51;color:#fff;font-size:24rpx;line-height:64rpx;white-space:nowrap}
.profile-head .avatar-button{width:112rpx;height:112rpx;margin-right:20rpx;padding:0;line-height:112rpx;background:linear-gradient(135deg,#FFC87B,#FF8B5A);font-size:44rpx}.avatar-button::after{border:0}.avatar image{width:100%;height:100%;border-radius:34rpx}.avatar-edit{position:absolute;right:-7rpx;top:-7rpx;display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border:4rpx solid #fff;border-radius:50%;background:#173126;color:#fff;font-size:18rpx;line-height:1}.nickname-edit{color:#779087;font-size:23rpx}.nickname-editor{display:flex;align-items:center;gap:12rpx;margin-bottom:18rpx;padding:18rpx}.nickname-editor input{flex:1;height:68rpx;padding:0 20rpx;border:2rpx solid #dce7df;border-radius:16rpx;background:#f8fbf9;font-size:26rpx}.nickname-editor button{width:auto;margin:0;padding:0 22rpx;background:#eef4f0;color:#526259;font-size:24rpx;line-height:68rpx}.nickname-editor .primary{background:#168a51;color:#fff}.mobile-bind>view{display:flex;flex-direction:column;gap:7rpx}.mobile-number{color:#173126;font-weight:800}
