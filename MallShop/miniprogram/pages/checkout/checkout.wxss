.checkout-page { padding-bottom: 210rpx; }.address-card { position: relative; display: flex; align-items: center; padding: 28rpx 24rpx; border-top: 8rpx solid var(--green); }.address-icon { display: flex; flex: 0 0 62rpx; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-right: 20rpx; border-radius: 20rpx; background: var(--green-soft); color: var(--green); font-weight: 900; }.address-main { flex: 1; min-width: 0; }.address-label { color: var(--green); font-size: 21rpx; font-weight: 800; }.address-detail { margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 29rpx; font-weight: 900; }.address-user { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }.arrow { color: #9DA9A2; font-size: 44rpx; }.eta { margin: 18rpx 0; padding: 20rpx 24rpx; border-radius: 22rpx; background: #EAF7EF; }.eta > text { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 14rpx; border-radius: 14rpx; background: var(--green); color: white; font-size: 18rpx; font-weight: 900; }.eta b,.eta small { display: block; }.eta b { font-size: 23rpx; }.eta small { margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }
.order-card,.cost-card { margin-top: 18rpx; padding: 26rpx; }.card-title { padding-bottom: 22rpx; border-bottom: 2rpx solid var(--line); }.card-title > text { font-size: 28rpx; font-weight: 900; }.card-title small { color: var(--muted); }.order-item { display: flex; align-items: center; margin-top: 24rpx; }.order-item image { width: 108rpx; height: 108rpx; margin-right: 18rpx; border-radius: 20rpx; }.order-info { flex: 1; }.order-info > view { font-weight: 800; }.order-info small { display: block; margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }.order-price { text-align: right; }.order-price text,.order-price small { display: block; }.order-price text { font-weight: 800; }.order-price small { margin-top: 8rpx; color: var(--muted); }
.cost-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; }.cost-row > view > text:first-child { display: block; }.cost-row small { display: block; margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }.free,.discount { color: #ED5A37; font-weight: 800; }.divider { height: 2rpx; margin: 10rpx 0; background: var(--line); }.coupon-row > view:last-child { display: flex; align-items: center; }.coupon-choice { margin-left: 10rpx; padding: 9rpx 13rpx; border: 2rpx solid var(--line); border-radius: 12rpx; color: var(--muted); font-size: 19rpx; }.coupon-choice.active { border-color: var(--green); background: var(--green-soft); color: var(--green); font-weight: 800; }.points-cut { padding: 12rpx 18rpx; border-radius: 14rpx; background: #FFF3E9; color: #DE6631; text-align: right; font-size: 20rpx; }
.note-card { display: flex; align-items: center; margin-top: 18rpx; padding: 24rpx 26rpx; }.note-card > text:first-child { margin-right: 24rpx; font-weight: 800; }.note-card input { flex: 1; color: var(--muted); font-size: 22rpx; }.pay-hint { display: flex; align-items: center; padding: 28rpx 20rpx; color: var(--muted); }.pay-hint > text { margin-right: 14rpx; }.pay-hint b,.pay-hint small { display: block; }.pay-hint b { color: var(--ink); font-size: 22rpx; }.pay-hint small { margin-top: 5rpx; font-size: 19rpx; }
.pay-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx; background: var(--surface); border-top: 2rpx solid var(--line); box-shadow: 0 -10rpx 34rpx rgba(25,61,41,.08); }.pay-bar > view > small { display: block; color: var(--muted); font-size: 20rpx; }.pay-bar > view > view { color: #ED5A37; font-size: 42rpx; font-weight: 900; }.pay-bar > view > view text { font-size: 22rpx; }.pay-bar button { width: 340rpx; height: 90rpx; margin: 0; line-height: 90rpx; font-size: 26rpx; }
.address-mask { position: fixed; z-index: 80; inset: 0; display: flex; align-items: flex-end; background: rgba(7,28,17,.55); }.address-sheet { width: 100%; padding: 34rpx; border-radius: 42rpx 42rpx 0 0; background: var(--surface); }.sheet-head { margin-bottom: 26rpx; }.sheet-head text:first-child { font-size: 32rpx; font-weight: 900; }.sheet-head text:last-child { font-size: 40rpx; }.address-sheet label { display: flex; align-items: center; min-height: 94rpx; border-bottom: 2rpx solid var(--line); }.address-sheet label > text { width: 150rpx; font-weight: 800; }.address-sheet label input { flex: 1; }.address-sheet button { height: 90rpx; margin-top: 36rpx; line-height: 90rpx; font-size: 27rpx; }
.eta .strong { font-size: 23rpx; }.eta .small { margin-top: 5rpx; font-size: 19rpx; }.order-info .small,.order-price .small { margin-top: 8rpx; }.cost-row .small { margin-top: 5rpx; font-size: 19rpx; }.pay-hint .strong { font-size: 22rpx; }.pay-hint .small { margin-top: 5rpx; font-size: 19rpx; }
