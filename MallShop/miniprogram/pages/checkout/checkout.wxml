<view class="checkout-page page-shell">
  <view class="address-card card" bindtap="openAddress">
    <view class="address-icon">址</view>
    <view class="address-main">
      <view class="address-label">送到这里</view>
      <view class="address-detail">{{address.detail}}</view>
      <view class="address-user">{{address.name}}　{{address.phone}}</view>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="eta row"><text>闪</text><view><text class="strong">预计 30 分钟送达</text><text class="small">当前运力充足，鲜品优先配送</text></view></view>

  <view class="order-card card">
    <view class="card-title between"><text>商品清单</text><text class="small">共 {{items.length}} 种</text></view>
    <view class="order-item" wx:for="{{items}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill" /><view class="order-info"><view>{{item.name}}</view><text class="small">{{item.spec}}</text></view><view class="order-price"><text>¥{{item.price}}</text><text class="small">×{{item.count}}</text></view>
    </view>
  </view>

  <view class="cost-card card">
    <view class="cost-row"><text>商品合计</text><text>¥{{subtotal}}</text></view>
    <view class="cost-row"><view><text>配送费</text><text class="small">{{deliveryFee === '0.00' ? '满 30 元免配送费' : '未满 30 元，配送费 3 元'}}</text></view><text class="{{deliveryFee === '0.00' ? 'free' : ''}}">{{deliveryFee === '0.00' ? '免配送费' : '¥' + deliveryFee}}</text></view>
    <view class="divider"></view>
    <view class="cost-row coupon-row"><view><text>优惠券</text><text class="small">新人满 29 减 5</text></view><view><text class="discount" wx:if="{{coupon}}">-¥{{coupon}}.00</text><text class="coupon-choice {{coupon === 5 ? 'active' : ''}}" data-value="5" bindtap="chooseCoupon">使用</text><text class="coupon-choice {{coupon === 0 ? 'active' : ''}}" data-value="0" bindtap="chooseCoupon">不用</text></view></view>
    <view class="cost-row"><view><text>积分抵扣</text><text class="small">可用 250 积分，最高抵 ¥2.50</text></view><switch color="#168A51" checked="{{pointsEnabled}}" bindchange="togglePoints" /></view>
    <view class="points-cut" wx:if="{{pointsEnabled}}">本单积分已抵扣 ¥{{pointsDeduction}}</view>
  </view>

  <view class="note-card card"><text>订单备注</text><input value="{{note}}" bindinput="bindNote" maxlength="80" placeholder="口味、门牌或配送要求（选填）" /><text class="arrow">›</text></view>
  <view class="pay-hint"><text>盾</text><view><text class="strong">支付安全保障</text><text class="small">支付模块独立预留，当前为前端模拟演示</text></view></view>
</view>

<view class="pay-bar safe-bottom"><view><text class="small">实付金额</text><view><text>¥</text>{{payTotal}}</view></view><button class="primary-btn" bindtap="submitOrder">提交订单并支付</button></view>

<view class="address-mask" wx:if="{{showAddress}}" bindtap="closeAddress">
  <view class="address-sheet safe-bottom" catchtap="noop">
    <view class="sheet-head between"><text>编辑收货地址</text><text bindtap="closeAddress">×</text></view>
    <label><text>收货人</text><input value="{{addressDraft.name}}" data-field="name" bindinput="bindAddress" placeholder="请输入姓名" /></label>
    <label><text>手机号</text><input value="{{addressDraft.phone}}" data-field="phone" bindinput="bindAddress" type="number" maxlength="11" placeholder="请输入手机号" /></label>
    <label><text>详细地址</text><input value="{{addressDraft.detail}}" data-field="detail" bindinput="bindAddress" placeholder="小区、楼栋和门牌号" /></label>
    <button class="primary-btn" bindtap="saveAddress">保存并使用</button>
  </view>
</view>
